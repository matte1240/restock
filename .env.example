# Chiave API Anthropic, richiesta per generare le proposte d'ordine con l'AI.
ANTHROPIC_API_KEY=

# Modello Claude da usare (opzionale, default: claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# Percorso del file database SQLite (opzionale, default: ./data/restock.db).
DATABASE_PATH=./data/restock.db
